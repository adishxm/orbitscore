  "components": {
    "schemas": {
      "Agent37Candidate": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "value": {
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "exact_quote": {
            "type": "string",
            "title": "Exact Quote"
          },
          "source_identifier": {
            "type": "string",
            "title": "Source Identifier"
          },
          "uncertainty": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Uncertainty",
            "description": "Estimated extraction uncertainty (0.0=certain, 1.0=uncertain)"
          },
          "confidence_tier": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "title": "Confidence Tier",
            "default": "MEDIUM"
          },
          "human_confirmed": {
            "type": "boolean",
            "title": "Human Confirmed",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "field",
          "value",
          "exact_quote",
          "source_identifier",
          "uncertainty"
        ],
        "title": "Agent37Candidate"
      },
      "Agent37TriageRequest": {
        "properties": {
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "source_identifier": {
            "type": "string",
            "title": "Source Identifier",
            "default": "doc_ref"
          },
          "mission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mission Id"
          }
        },
        "type": "object",
        "required": [
          "excerpt"
        ],
        "title": "Agent37TriageRequest"
      },
      "Agent37TriageResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "FALLBACK_PARSED",
              "DISABLED",
              "ERROR"
            ],
            "title": "Status"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "agent37"
          },
          "model_template": {
            "type": "string",
            "title": "Model Template",
            "default": "spacecraft-evidence-triage-v1"
          },
          "request_time": {
            "type": "string",
            "title": "Request Time"
          },
          "source_hash": {
            "type": "string",
            "title": "Source Hash"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Agent37Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Agent37 candidate extraction only. Requires independent human engineering confirmation."
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "status",
          "request_time",
          "source_hash"
        ],
        "title": "Agent37TriageResponse"
      },
      "ArtifactRecord": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "title": "Artifact Id"
          },
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "uploaded_at": {
            "type": "string",
            "title": "Uploaded At"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "warning": {
            "type": "string",
            "title": "Warning",
            "default": "SYNTHETIC TEST EVIDENCE ONLY - NOT A REAL FLIGHT RECORD"
          },
          "locator": {
            "additionalProperties": true,
            "type": "object",
            "title": "Locator"
          }
        },
        "type": "object",
        "required": [
          "artifact_id",
          "mission_id",
          "filename",
          "media_type",
          "sha256",
          "uploaded_at",
